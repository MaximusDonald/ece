# ECO-Compliance Engine - Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ece

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (local)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production

# LLM Provider (at least one required)
# Priority order: Groq > Gemini > Anthropic > OpenAI

# Groq (fast inference on open models: Llama, Mixtral, Gemma)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-key
# Optional: override default model (llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (generous free tier)
# Get key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override default model (gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic (alternative)
# Get key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# OpenAI
# Get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key

# OAuth Providers (optional)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000